<Application x:Class="ZapretGUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="BrandSuccessBrush" Color="#107C10" />
            <SolidColorBrush x:Key="BrandErrorBrush" Color="#D13438" />
            <SolidColorBrush x:Key="BrandWarningBrush" Color="#FF8C00" />
        </ResourceDictionary>
    </Application.Resources>
</Application>