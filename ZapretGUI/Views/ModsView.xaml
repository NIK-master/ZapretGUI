<UserControl x:Class="ZapretGUI.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Foreground="White">

    <UserControl.Resources>
        <Style x:Key="ModCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#27272A"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="#0A1F0A"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BrandSuccessBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="IconLeft" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,1,6,0" FontSize="10" Visibility="Collapsed"/>
                                <TextBlock x:Name="BtnText" Text="Включить" VerticalAlignment="Center"/>
                                <TextBlock x:Name="IconRight" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="6,1,0,0" FontSize="11" Visibility="Visible"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1E3A8A"/>
                                <Setter TargetName="BtnText" Property="Text" Value="Включить"/>
                                <Setter TargetName="IconLeft" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="IconRight" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#7F1D1D"/>
                                <Setter TargetName="BtnText" Property="Text" Value="Убрать"/>
                                <Setter TargetName="IconLeft" Property="Text" Value="&#xE711;"/>
                                <Setter TargetName="IconLeft" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="IconRight" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для компактных кнопок панели инструментов редактора -->
        <Style x:Key="EditorToolBtn" TargetType="Button">
            <Setter Property="Background" Value="#1F1F23"/>
            <Setter Property="Foreground" Value="#D4D4D8"/>
            <Setter Property="BorderBrush" Value="#2E2E34"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#2E2E36"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#4A4A55"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ModItemTemplate">
            <Border x:Name="ModCardContainer" Style="{StaticResource ModCardStyle}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform X="20" />
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Meta.Name}" FontSize="16" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                            <Border Background="#27272A" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Meta.Version, StringFormat='v{0}'}" FontFamily="Consolas" FontSize="11" Foreground="#A1A1AA"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Meta.Author, StringFormat='Автор: {0}'}" FontSize="12" Foreground="{DynamicResource BrandSuccessBrush}" Margin="0,2,0,6" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Meta.Description}" FontSize="13" Foreground="#AAAAAA" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="130">
                        <Button Style="{StaticResource ModActionButton}" Click="BtnToggleMod_Click" HorizontalAlignment="Stretch"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Center">
                            <Button Background="Transparent" Foreground="#888888" BorderThickness="0" Cursor="Hand" FontSize="12" Margin="0,0,10,0" Click="BtnEditMod_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,2,4,0"/>
                                    <TextBlock Text="Изменить" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Background="Transparent" Foreground="#60A5FA" BorderThickness="0" Cursor="Hand" FontSize="12" Margin="0,0,10,0" Click="BtnExportMod_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE78C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,2,4,0"/>
                                    <TextBlock Text="Экспорт" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Background="Transparent" Foreground="#F44336" BorderThickness="0" Cursor="Hand" FontSize="12" Click="BtnDeleteMod_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,2,4,0"/>
                                    <TextBlock Text="Удалить" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0A0A0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A2A2A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <!-- Сетка с основным контентом (именно она будет размываться) -->
        <Grid x:Name="ContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0C0C0C" CornerRadius="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="15">
                <StackPanel>
                    <TextBlock Text="Модификации" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                    <Button x:Name="BtnStrategies" Style="{StaticResource SidebarButtonStyle}" Click="BtnStrategies_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text=".bat Стратегии" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnDomainLists" Style="{StaticResource SidebarButtonStyle}" Click="BtnDomainLists_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Листы доменов" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Height="1" Background="#2A2A2A" Margin="0,10"/>
                    <Button x:Name="BtnGuide" Style="{StaticResource SidebarButtonStyle}" Click="BtnGuide_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9CE;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Руководство" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock x:Name="TxtCategoryTitle" Text=".bat Стратегии" FontSize="22" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtCategoryDesc" Text="Пользовательские скрипты обхода для специфичных задач." Foreground="#888888" FontSize="13" Margin="0,5,0,15" TextWrapping="Wrap"/>

                    <WrapPanel x:Name="ActionButtonsPanel" Orientation="Horizontal">
                        <Button Background="Transparent" Foreground="#F44336" BorderBrush="#333333" BorderThickness="1" Padding="12,6" Margin="0,0,10,10" Cursor="Hand" Click="BtnDisableAll_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" Margin="0,1,6,0" FontSize="11" VerticalAlignment="Center" FontWeight="Bold"/>
                                <TextBlock Text="Отключить всё" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Background="Transparent" Foreground="#60A5FA" BorderBrush="#333333" BorderThickness="1" Padding="12,6" Margin="0,0,10,10" Cursor="Hand" Click="BtnImportMod_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" Margin="0,1,6,0" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Импорт (.zip)" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Background="Transparent" Foreground="#A0A0A0" BorderBrush="#333333" BorderThickness="1" Padding="12,6" Margin="0,0,10,10" Cursor="Hand" Click="BtnOpenModsFolder_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Margin="0,1,6,0" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Папка" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Background="{DynamicResource BrandSuccessBrush}" Foreground="White" BorderThickness="0" Padding="12,6" Margin="0,0,10,10" Cursor="Hand" Click="BtnCreateMod_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,1,6,0" FontSize="12" VerticalAlignment="Center" FontWeight="Bold"/>
                                <TextBlock Text="Создать" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>

                <ScrollViewer x:Name="ModsListsPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,15,0">
                    <StackPanel>
                        <TextBlock x:Name="ActiveModsHeader" Text="ВКЛЮЧЕННЫЕ МОДЫ" Foreground="{DynamicResource BrandSuccessBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="ActiveModsList" ItemTemplate="{StaticResource ModItemTemplate}"/>

                        <Border x:Name="ModsDivider" Height="1" Background="#2A2A2A" Margin="0,10,0,20"/>

                        <TextBlock x:Name="AvailableModsHeader" Text="ДОСТУПНЫЕ МОДЫ" Foreground="#888888" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="AvailableModsList" ItemTemplate="{StaticResource ModItemTemplate}"/>

                        <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center" Margin="0,60,0,0" Visibility="Collapsed">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="48" Foreground="#333333" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="В этой категории нет установленных модов" FontSize="16" Foreground="#666666" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="GuidePanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,15,0">
                    <StackPanel Margin="0,0,0,20">

                        <!-- Вводный баннер -->
                        <Border Background="#0A1F0A" BorderBrush="{DynamicResource BrandSuccessBrush}" BorderThickness="1" CornerRadius="10" Padding="18,15" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="⚡" FontSize="24" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Система модификаций Zapret" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,0,0,4"/>
                                    <TextBlock Text="Здесь вы можете создавать собственные стратегии обхода, собирать списки доменов и обмениваться готовыми модами с другими пользователями. Все изменения изолированы и не ломают базовые файлы программы." Foreground="#B0B0B0" FontSize="13" TextWrapping="Wrap" LineHeight="19"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 1. Типы модификаций -->
                        <Border Background="#18181B" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,15" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="#60A5FA" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="1. ДВА ТИПА МОДИФИКАЦИЙ" FontWeight="Bold" FontSize="15" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Foreground="#CCCCCC" FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,8">
                                    <Run Text="• .bat Стратегии:" Foreground="#4ADE80" FontWeight="SemiBold"/>
                                    <Run Text="Индивидуальные профили запуска ядра "/>
                                    <Run Text="winws.exe" FontFamily="Consolas" Foreground="White"/>
                                    <Run Text=" (например, под конкретные игры или провайдеров). При включении такой мод автоматически появляется в списке выбора конфигураций на «Главной» вкладке с префиксом "/>
                                    <Run Text="mod_" FontFamily="Consolas" Foreground="White"/>
                                    <Run Text="."/>
                                </TextBlock>

                                <TextBlock Foreground="#CCCCCC" FontSize="13" TextWrapping="Wrap" LineHeight="20">
                                    <Run Text="• Листы доменов:" Foreground="#60A5FA" FontWeight="SemiBold"/>
                                    <Run Text="Именованные списки сайтов. Когда вы включаете такой мод, программа автоматически внедряет его домены в общий список "/>
                                    <Run Text="list-general.txt" FontFamily="Consolas" Foreground="White"/>
                                    <Run Text=" без дубликатов. При отключении мода его сайты аккуратно удаляются из общего списка."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- 2. Создание и активация -->
                        <Border Background="#18181B" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,15" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Foreground="#4ADE80" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="2. СОЗДАНИЕ И АКТИВАЦИЯ" FontWeight="Bold" FontSize="15" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Foreground="#AAAAAA" FontSize="13" TextWrapping="Wrap" LineHeight="21">
                                    <Run Text="1." Foreground="White" FontWeight="Bold"/>
                                    <Run Text=" Выберите слева нужную категорию («.bat Стратегии» или «Листы доменов») и нажмите зелёную кнопку "/>
                                    <Run Text="«+ Создать»" Foreground="#4ADE80" FontWeight="SemiBold"/>
                                    <Run Text=".&#x0a;"/>
                                    <Run Text="2." Foreground="White" FontWeight="Bold"/>
                                    <Run Text=" Укажите технический ID папки (на английском), отображаемое название, автора и краткое описание.&#x0a;"/>
                                    <Run Text="3." Foreground="White" FontWeight="Bold"/>
                                    <Run Text=" Для стратегий программа автоматически подготовит базовый рабочий шаблон с вызовом "/>
                                    <Run Text="winws.exe" FontFamily="Consolas" Foreground="White"/>
                                    <Run Text=".&#x0a;"/>
                                    <Run Text="4." Foreground="White" FontWeight="Bold"/>
                                    <Run Text=" Нажмите "/>
                                    <Run Text="«Включить»" Foreground="#60A5FA" FontWeight="SemiBold"/>
                                    <Run Text=" на карточке мода, чтобы активировать его. Если обход уже запущен — перезапустите его на Главной."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- 3. Встроенная студия редактирования -->
                        <Border Background="#18181B" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,15" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Foreground="#F59E0B" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="3. РЕДАКТОР КОДА И СВОЙСТВ" FontWeight="Bold" FontSize="15" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="Нажмите «Изменить» на карточке мода, чтобы открыть встроенную студию:" Foreground="#CCCCCC" FontSize="13" Margin="0,0,0,8"/>

                                <TextBlock Foreground="#AAAAAA" FontSize="13" TextWrapping="Wrap" LineHeight="21">
                                    <Run Text="• Паспорт мода:" Foreground="White" FontWeight="SemiBold"/>
                                    <Run Text=" В верхней панели вы можете в любой момент изменить Название, Автора, Версию и Описание мода (кнопка «Свойства мода» позволяет свернуть эту панель).&#x0a;"/>
                                    <Run Text="• Быстрые сниппеты (.bat):" Foreground="White" FontWeight="SemiBold"/>
                                    <Run Text=" Нажимайте на готовые кнопки ("/>
                                    <Run Text="--new ^, --filter-tcp, %BIN%, %LISTS%" FontFamily="Consolas" Foreground="#4ADE80"/>
                                    <Run Text="), чтобы мгновенно вставлять аргументы в место курсора без опечаток.&#x0a;"/>
                                    <Run Text="• Проверка синтаксиса (.bat):" Foreground="White" FontWeight="SemiBold"/>
                                    <Run Text=" Кнопка "/>
                                    <Run Text="«✓ Проверить синтаксис»" Foreground="#4ADE80"/>
                                    <Run Text=" тестирует скрипт на незакрытые кавычки, наличие вызова ядра и правильность флагов с указанием точного номера строки.&#x0a;"/>
                                    <Run Text="• Авто-очистка доменов (Листы):" Foreground="White" FontWeight="SemiBold"/>
                                    <Run Text=" Кнопка "/>
                                    <Run Text="«Очистить дубли и URL»" Foreground="#60A5FA"/>
                                    <Run Text=" сама превратит скопированные из браузера ссылки вида "/>
                                    <Run Text="https://www.site.com/page" FontFamily="Consolas" Foreground="White"/>
                                    <Run Text=" в чистый домен "/>
                                    <Run Text="site.com" FontFamily="Consolas" Foreground="White"/>
                                    <Run Text=", удалит дубликаты и отсортирует список по алфавиту.&#x0a;"/>
                                    <Run Text="• Горячие клавиши:" Foreground="White" FontWeight="SemiBold"/>
                                    <Run Text=" Используйте "/>
                                    <Run Text="Ctrl + F" FontFamily="Consolas" Foreground="White"/>
                                    <Run Text=" для поиска и замены текста, "/>
                                    <Run Text="Ctrl + S" FontFamily="Consolas" Foreground="White"/>
                                    <Run Text=" для быстрого сохранения и кнопки "/>
                                    <Run Text="A- / A+" FontFamily="Consolas" Foreground="White"/>
                                    <Run Text=" для изменения масштаба шрифта."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- 4. Импорт и экспорт -->
                        <Border Background="#18181B" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,15">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" Foreground="#A855F7" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="4. ИМПОРТ И ЭКСПОРТ (.ZIP / .NETFIX-MOD)" FontWeight="Bold" FontSize="15" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Foreground="#AAAAAA" FontSize="13" TextWrapping="Wrap" LineHeight="21">
                                    <Run Text="• Экспорт:" Foreground="#60A5FA" FontWeight="SemiBold"/>
                                    <Run Text=" Нажмите «Экспорт» на карточке любого мода. Программа упакует скрипт/список и его паспорт ("/>
                                    <Run Text="mod.json" FontFamily="Consolas" Foreground="White"/>
                                    <Run Text=") в готовый архив, которым можно сразу поделиться с друзьями.&#x0a;"/>
                                    <Run Text="• Импорт:" Foreground="#4ADE80" FontWeight="SemiBold"/>
                                    <Run Text=" Нажмите «Импорт (.zip)» в верхней панели и выберите скачанный архив. Программа сама прочитает паспорт мода, определит его категорию (стратегия или список доменов) и установит в нужную папку."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ПРОКАЧАННАЯ СТУДИЯ РЕДАКТИРОВАНИЯ МОДА -->
        <Grid x:Name="EditorOverlay" Background="#CC000000" Visibility="Collapsed" Panel.ZIndex="200">
            <Border x:Name="EditorContentBorder" Background="#141414" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Width="820" Height="640" Padding="20" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                        <TranslateTransform Y="10"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="10" Opacity="0.8"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- 0: Шапка -->
                        <RowDefinition Height="Auto"/>
                        <!-- 1: Метаданные мода (Имя, Автор, Версия, Описание) -->
                        <RowDefinition Height="Auto"/>
                        <!-- 2: Тулбар редактора -->
                        <RowDefinition Height="Auto"/>
                        <!-- 3: Панель поиска и замены -->
                        <RowDefinition Height="Auto"/>
                        <!-- 4: Панель быстрых сниппетов -->
                        <RowDefinition Height="*"/>
                        <!-- 5: Редактор кода с номерами строк -->
                        <RowDefinition Height="Auto"/>
                        <!-- 6: Статус-бар и кнопки сохранения -->
                    </Grid.RowDefinitions>

                    <!-- 0. ШАПКА -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1E3A8A" CornerRadius="6" Padding="7,5" Margin="0,0,10,0">
                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Foreground="#60A5FA" FontSize="14"/>
                            </Border>
                            <StackPanel>
                                <TextBlock x:Name="TxtEditorTitle" Text="Редактор мода" FontSize="17" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtEditorSubTitle" Text="ID: mod_folder • strategy.bat" FontFamily="Consolas" FontSize="11" Foreground="#888888"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1" Style="{StaticResource EditorToolBtn}" Click="BtnToggleMetaPanel_Click" ToolTip="Показать/скрыть настройки паспорта мода">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,1,6,0" FontSize="12"/>
                                <TextBlock Text="Свойства мода (Название / Автор)"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 1. ПАНЕЛЬ РЕДАКТИРОВАНИЯ МЕТАДАННЫХ МОДА (Название, Автор, Версия, Описание) -->
                    <Border x:Name="MetaEditorPanel" Grid.Row="1" Background="#1A1A1E" BorderBrush="#2A2A32" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10" Visibility="Visible">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="0.8*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Название мода:" Foreground="#A0A0A0" FontSize="11" Margin="0,0,0,3"/>
                                <ui:TextBox x:Name="TxtEditModName" FontSize="13"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Автор:" Foreground="#A0A0A0" FontSize="11" Margin="0,0,0,3"/>
                                <ui:TextBox x:Name="TxtEditModAuthor" FontSize="13"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="4">
                                <TextBlock Text="Версия:" Foreground="#A0A0A0" FontSize="11" Margin="0,0,0,3"/>
                                <ui:TextBox x:Name="TxtEditModVersion" FontFamily="Consolas" FontSize="13"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,8,0,0">
                                <TextBlock Text="Описание:" Foreground="#A0A0A0" FontSize="11" Margin="0,0,0,3"/>
                                <ui:TextBox x:Name="TxtEditModDesc" FontSize="13"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 2. ПАНЕЛЬ ИНСТРУМЕНТОВ РЕДАКТОРА -->
                    <Border Grid.Row="2" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,8">
                        <Grid>
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource EditorToolBtn}" Click="BtnEditorUndo_Click" ToolTip="Отменить (Ctrl+Z)">
                                    <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets"/>
                                </Button>
                                <Button Style="{StaticResource EditorToolBtn}" Click="BtnEditorRedo_Click" ToolTip="Повторить (Ctrl+Y)">
                                    <TextBlock Text="&#xE7A6;" FontFamily="Segoe MDL2 Assets"/>
                                </Button>

                                <Border Width="1" Background="#2E2E34" Margin="4,2,8,2"/>

                                <Button Style="{StaticResource EditorToolBtn}" Click="BtnToggleSearch_Click" ToolTip="Поиск и замена (Ctrl+F)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Margin="0,1,5,0" FontSize="11"/>
                                        <TextBlock Text="Поиск"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource EditorToolBtn}" Click="BtnToggleWordWrap_Click" ToolTip="Перенос по словам">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" Margin="0,1,5,0" FontSize="11"/>
                                        <TextBlock x:Name="TxtWordWrapStatus" Text="Перенос: Вкл"/>
                                    </StackPanel>
                                </Button>

                                <Border Width="1" Background="#2E2E34" Margin="4,2,8,2"/>

                                <!-- Контекстные инструменты для .bat -->
                                <StackPanel x:Name="BatToolsPanel" Orientation="Horizontal">
                                    <Button Style="{StaticResource EditorToolBtn}" Click="BtnCommentLine_Click" ToolTip="Закомментировать / раскомментировать строку (::)">
                                        <TextBlock Text=":: Коммент" FontFamily="Consolas"/>
                                    </Button>
                                    <Button Style="{StaticResource EditorToolBtn}" Click="BtnValidateBat_Click" Foreground="#4ADE80" ToolTip="Проверить скрипт на ошибки для Zapret">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Margin="0,1,5,0" FontSize="11"/>
                                            <TextBlock Text="Проверить синтаксис"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Контекстные инструменты для списков доменов -->
                                <StackPanel x:Name="ListToolsPanel" Orientation="Horizontal" Visibility="Collapsed">
                                    <Button Style="{StaticResource EditorToolBtn}" Click="BtnCleanDomains_Click" Foreground="#60A5FA" ToolTip="Удалить https://, пути, пробелы, пустые строки, дубликаты и отсортировать по алфавиту">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE894;" FontFamily="Segoe MDL2 Assets" Margin="0,1,5,0" FontSize="11"/>
                                            <TextBlock Text="Очистить дубли и URL (Сортировка A-Z)"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </WrapPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource EditorToolBtn}" Click="BtnZoomOut_Click" ToolTip="Уменьшить шрифт">
                                    <TextBlock Text="A-" FontFamily="Consolas" FontWeight="Bold"/>
                                </Button>
                                <Button Style="{StaticResource EditorToolBtn}" Click="BtnZoomIn_Click" Margin="0" ToolTip="Увеличить шрифт">
                                    <TextBlock Text="A+" FontFamily="Consolas" FontWeight="Bold"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 3. ПАНЕЛЬ ПОИСКА И ЗАМЕНЫ (По умолчанию скрыта) -->
                    <Border x:Name="SearchPanel" Grid.Row="3" Background="#1C1C22" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ui:TextBox x:Name="TxtSearchQuery" Grid.Column="0" PlaceholderText="Найти текст..." FontFamily="Consolas" FontSize="12"/>
                            <ui:TextBox x:Name="TxtReplaceQuery" Grid.Column="2" PlaceholderText="Заменить на..." FontFamily="Consolas" FontSize="12"/>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button Style="{StaticResource EditorToolBtn}" Content="Найти далее" Click="BtnFindNext_Click"/>
                                <Button Style="{StaticResource EditorToolBtn}" Content="Заменить всё" Click="BtnReplaceAll_Click"/>
                                <Button Style="{StaticResource EditorToolBtn}" Content="✕" Margin="0" Click="BtnToggleSearch_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 4. БЫСТРЫЕ СНИППЕТЫ ДЛЯ ЗАПРЕТА (Только для .bat) -->
                    <ScrollViewer x:Name="SnippetsBar" Grid.Row="4" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Вставка:" Foreground="#71717A" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource EditorToolBtn}" Content="winws.exe" Tag="&quot;%BIN%winws.exe&quot; " Click="BtnInsertSnippet_Click" FontFamily="Consolas"/>
                            <Button Style="{StaticResource EditorToolBtn}" Content="--new ^" Tag="--new ^&#x0d;&#x0a;" Click="BtnInsertSnippet_Click" FontFamily="Consolas"/>
                            <Button Style="{StaticResource EditorToolBtn}" Content="--filter-tcp" Tag="--filter-tcp=80,443 " Click="BtnInsertSnippet_Click" FontFamily="Consolas"/>
                            <Button Style="{StaticResource EditorToolBtn}" Content="--filter-udp" Tag="--filter-udp=443,50000-50100 " Click="BtnInsertSnippet_Click" FontFamily="Consolas"/>
                            <Button Style="{StaticResource EditorToolBtn}" Content="--hostlist" Tag="--hostlist=&quot;%LISTS%list-general.txt&quot; " Click="BtnInsertSnippet_Click" FontFamily="Consolas"/>
                            <Button Style="{StaticResource EditorToolBtn}" Content="--dpi-desync" Tag="--dpi-desync=fake,split2 " Click="BtnInsertSnippet_Click" FontFamily="Consolas"/>
                            <Button Style="{StaticResource EditorToolBtn}" Content="%BIN%" Tag="%BIN%" Click="BtnInsertSnippet_Click" FontFamily="Consolas"/>
                            <Button Style="{StaticResource EditorToolBtn}" Content="%LISTS%" Tag="%LISTS%" Click="BtnInsertSnippet_Click" FontFamily="Consolas"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 5. ТЕКСТОВЫЙ РЕДАКТОР С НОМЕРАМИ СТРОК -->
                    <Border Grid.Row="5" Background="#0C0C0C" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Колонка с номерами строк -->
                            <Border Grid.Column="0" Background="#121216" BorderBrush="#222226" BorderThickness="0,0,1,0" Padding="8,10,8,10" MinWidth="42">
                                <ScrollViewer x:Name="LineNumbersScrollViewer" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" IsHitTestVisible="False">
                                    <TextBlock x:Name="TxtLineNumbers" Text="1" FontFamily="Consolas" FontSize="13" Foreground="#52525B" TextAlignment="Right"/>
                                </ScrollViewer>
                            </Border>

                            <!-- Основное поле кода -->
                            <TextBox x:Name="EditorTextBox" Grid.Column="1" Background="Transparent" Foreground="#4ADE80" CaretBrush="White"
                                     FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Padding="10"
                                     TextChanged="EditorTextBox_TextChanged" SelectionChanged="EditorTextBox_SelectionChanged"
                                     ScrollViewer.ScrollChanged="EditorTextBox_ScrollChanged" PreviewKeyDown="EditorTextBox_PreviewKeyDown"/>
                        </Grid>
                    </Border>

                    <!-- 6. СТАТУС-БАР И КНОПКИ СОХРАНЕНИЯ (Исправлено наложение текста на кнопки) -->
                    <Grid Grid.Row="6" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TxtCursorPos" Grid.Column="0" Text="Стр: 1, Столб: 1" FontFamily="Consolas" FontSize="12" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <TextBlock x:Name="TxtStatsInfo" Grid.Column="1" Text="Строк: 1" FontFamily="Consolas" FontSize="12" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,15,0"/>

                        <TextBlock x:Name="TxtEditorStatusMsg" Grid.Column="2" Text="" FontFamily="Consolas" FontSize="12" Foreground="#4ADE80" 
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,15,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Отмена" Background="Transparent" Foreground="#A0A0A0" BorderBrush="#333333" BorderThickness="1" Padding="15,7" Margin="0,0,10,0" Cursor="Hand" Click="BtnCloseEditor_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="💾 Сохранить мод" Background="{DynamicResource BrandSuccessBrush}" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Padding="15,7" Cursor="Hand" Click="BtnSaveEditor_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ОКНО СОЗДАНИЯ НОВОГО МОДА -->
        <Grid x:Name="CreateModOverlay" Background="#CC000000" Visibility="Collapsed" Panel.ZIndex="200">
            <Border x:Name="CreateContentBorder" Background="#141414" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="12" Width="450" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                        <TranslateTransform Y="10"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <StackPanel>
                    <TextBlock Text="Создать новый мод" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                    <TextBlock Text="Отображаемое имя:" Foreground="#A0A0A0" FontSize="12" Margin="0,0,0,5"/>
                    <ui:TextBox x:Name="TxtNewModName" Margin="0,0,0,10" TextChanged="TxtNewModName_TextChanged"/>

                    <Grid Margin="0,0,0,5">
                        <TextBlock Text="Уникальный ID (папка, англ.):" Foreground="#A0A0A0" FontSize="12" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtIdValidationStatus" Text="✓ ID свободен" FontFamily="Consolas" FontSize="11" Foreground="#4ADE80" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="TxtNewModId" Grid.Column="0" FontFamily="Consolas" TextChanged="TxtNewModId_TextChanged"/>
                        <Button Grid.Column="1" Style="{StaticResource EditorToolBtn}" Margin="8,0,0,0" Padding="10,0" Click="BtnRegenerateId_Click" ToolTip="Сгенерировать уникальный ID">
                            <TextBlock Text="🎲" FontSize="14"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="Автор:" Foreground="#A0A0A0" FontSize="12" Margin="0,0,0,5"/>
                    <ui:TextBox x:Name="TxtNewModAuthor" Margin="0,0,0,10"/>
                    <TextBlock Text="Описание:" Foreground="#A0A0A0" FontSize="12" Margin="0,0,0,5"/>
                    <ui:TextBox x:Name="TxtNewModDesc" Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Отмена" Background="Transparent" Foreground="#A0A0A0" BorderBrush="#333333" BorderThickness="1" Padding="15,6" Margin="0,0,10,0" Cursor="Hand" Click="BtnCloseCreateMod_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="BtnConfirmCreateMod" Content="Создать" Background="{DynamicResource BrandSuccessBrush}" Foreground="White" BorderThickness="0" Padding="15,6" Cursor="Hand" Click="BtnConfirmCreateMod_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ОКНО ПОДТВЕРЖДЕНИЯ И УВЕДОМЛЕНИЙ -->
        <Grid x:Name="ConfirmOverlay" Background="#CC000000" Visibility="Collapsed" Panel.ZIndex="300">
            <Border x:Name="ConfirmContentBorder" Background="#141414" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Width="420" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                        <TranslateTransform Y="10"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="35" ShadowDepth="10" Opacity="0.8"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="TxtConfirmTitle" Text="Подтверждение" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtConfirmMessage" Text="Вы уверены?" Foreground="#CCCCCC" FontSize="14" LineHeight="20" TextWrapping="Wrap" Margin="0,0,0,22"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnCancelConfirm" Content="Отмена" Background="Transparent" Foreground="#A0A0A0" BorderBrush="#333333" BorderThickness="1" Padding="15,6" Margin="0,0,10,0" Cursor="Hand" Click="BtnCancelConfirm_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="BtnExecuteConfirm" Content="Да" Background="#F44336" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Padding="16,6" Cursor="Hand" Click="BtnExecuteConfirm_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>