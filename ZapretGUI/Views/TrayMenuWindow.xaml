<Window x:Class="ZapretGUI.Views.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrayMenu" Width="300" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" Deactivated="Window_Deactivated">

    <Window.Resources>
        <!-- Стиль для строк меню с темным ховером без стандартного синего выделения WPF -->
        <Style x:Key="TrayActionItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1E1E1E"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#2E2E2E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#252525"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопки выхода (красный акцент при наведении) -->
        <Style x:Key="TrayDangerItemStyle" TargetType="Button" BasedOn="{StaticResource TrayActionItemStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2A1215"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#5C242A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MainBorder"
            Background="#121212"
            CornerRadius="14"
            BorderBrush="#2A2A2A"
            BorderThickness="1"
            Margin="12"
            RenderTransformOrigin="0.5,1">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="MenuScale" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="MenuTranslate" Y="0"/>
            </TransformGroup>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="6" Opacity="0.65"/>
        </Border.Effect>

        <StackPanel Margin="14,14,14,12">
            <!-- 1. ШАПКА: НАЗВАНИЕ, СТАТУС И ВЕРСИЯ -->
            <Grid Margin="2,0,2,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="7" Background="#1A2E1A" BorderBrush="#107C10" BorderThickness="1" Margin="0,0,9,0">
                    <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" Foreground="#4CAF50" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Zapret for ADHD" Foreground="White" FontSize="13.5" FontWeight="Bold" LineHeight="16"/>
                    <TextBlock x:Name="TxtSubStatus" Text="Службы остановлены" Foreground="#888888" FontSize="11" Margin="0,1,0,0"/>
                </StackPanel>

                <Border Grid.Column="2" Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="5" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTrayVersion" Text="v4.0" Foreground="#777777" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"/>
                </Border>
            </Grid>

            <!-- 2. ПИЛЮЛИ СТАТУСА МОДУЛЕЙ И АКТИВНОГО ПРОФИЛЯ -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Индикатор Zapret -->
                <Border Grid.Column="0" Background="#181818" BorderBrush="#262626" BorderThickness="1" CornerRadius="6" Padding="7,4" Margin="0,0,5,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="DotZapret" Width="6" Height="6" Fill="#D13438" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Zapret" Foreground="#CCCCCC" FontSize="10.5" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- Индикатор TgWsProxy -->
                <Border Grid.Column="1" Background="#181818" BorderBrush="#262626" BorderThickness="1" CornerRadius="6" Padding="7,4" Margin="0,0,5,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="DotProxy" Width="6" Height="6" Fill="#D13438" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Proxy" Foreground="#CCCCCC" FontSize="10.5" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- Интерактивный переключатель .bat профиля прямо из трея -->
                <Border Grid.Column="2" Background="#181818" BorderBrush="#262626" BorderThickness="1" CornerRadius="6" Padding="3,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Click="BtnPrevProfile_Click" ToolTip="Предыдущий конфиг" Cursor="Hand" Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                        <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" Foreground="#888888" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2,0">
                            <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" Foreground="#4CAF50" FontSize="9.5" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtActiveProfile" Text="general.bat" Foreground="White" FontFamily="Consolas" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="92" ToolTip="Активный профиль обхода"/>
                        </StackPanel>

                        <Button Grid.Column="2" Click="BtnNextProfile_Click" ToolTip="Следующий конфиг" Cursor="Hand" Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" Foreground="#888888" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. ГЛАВНАЯ КНОПКА ВКЛЮЧЕНИЯ / ОСТАНОВКИ ОБХОДА -->
            <Button x:Name="BtnTogglePower"
                    Background="#162919"
                    BorderThickness="1"
                    BorderBrush="#107C10"
                    Cursor="Hand"
                    Margin="0,0,0,10"
                    Padding="0,11"
                    HorizontalAlignment="Stretch"
                    Click="BtnTogglePower_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PowerBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="PowerIcon" Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#4CAF50" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="PowerText" Text="Включить обход" Foreground="White" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PowerBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PowerBorder" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- 4. БЕНТО-ПАНЕЛЬ ТЕЛЕМЕТРИИ: СКОРОСТЬ СЕТИ И ПИНГ -->
            <Border Background="#171717" BorderBrush="#242424" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,10">
                <StackPanel>
                    <!-- Строка 1: Входящий и Исходящий трафик -->
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Foreground="#4CAF50" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <StackPanel>
                                <TextBlock Text="Входящий" Foreground="#777777" FontSize="9.5"/>
                                <TextBlock x:Name="TxtDownloadSpeed" Text="0.0 Мбит/с" Foreground="White" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>

                        <Rectangle Grid.Column="1" Fill="#262626" Margin="0,2"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Исходящий" Foreground="#777777" FontSize="9.5" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="TxtUploadSpeed" Text="0.0 Мбит/с" Foreground="White" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </StackPanel>
                            <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" Foreground="#60A5FA" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="#222222" Margin="0,0,0,7"/>

                    <!-- Строка 2: Пинг + Кнопка быстрого обновления -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="&#xE916;" FontFamily="Segoe MDL2 Assets" Foreground="#888888" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Grid.Column="1" Text="Пинг (EU):" Foreground="#BBBBBB" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" x:Name="PingText" Text="..." Foreground="#4CAF50" FontFamily="Consolas" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>

                        <Button Grid.Column="3" Click="BtnRefreshPing_Click" ToolTip="Обновить пинг" Cursor="Hand" Background="#222222" BorderBrush="#333333" BorderThickness="1" Width="22" Height="22">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5">
                                        <TextBlock Text="&#xE149;" FontFamily="Segoe MDL2 Assets" Foreground="#AAAAAA" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <Rectangle Height="1" Fill="#222222" Margin="2,0,2,5"/>

            <!-- 5. БЫСТРЫЕ ДЕЙСТВИЯ -->
            <Button x:Name="BtnRestartBypass" Style="{StaticResource TrayActionItemStyle}" Click="BtnRestartBypass_Click" Margin="0,0,0,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE777;" FontFamily="Segoe MDL2 Assets" Foreground="#60A5FA" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Перезапустить службы" Foreground="#E0E0E0" FontSize="12.5" VerticalAlignment="Center"/>
                </Grid>
            </Button>

            <Button x:Name="BtnOpenApp" Style="{StaticResource TrayActionItemStyle}" Click="BtnOpenApp_Click" Margin="0,0,0,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" Foreground="#999999" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Открыть панель управления" Foreground="#E0E0E0" FontSize="12.5" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" Foreground="#555555" FontSize="10" VerticalAlignment="Center"/>
                </Grid>
            </Button>

            <Button x:Name="BtnExit" Style="{StaticResource TrayDangerItemStyle}" Click="BtnExit_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xF3B1;" FontFamily="Segoe MDL2 Assets" Foreground="#F44336" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Полностью закрыть" Foreground="#F44336" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>
            </Button>
        </StackPanel>
    </Border>
</Window>