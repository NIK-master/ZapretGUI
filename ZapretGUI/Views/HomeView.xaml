<UserControl x:Class="ZapretGUI.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Foreground="White">

    <UserControl.Resources>
        <Color x:Key="MainBtnColor">#107C10</Color>
        <SolidColorBrush x:Key="MainBtnBrush" Color="{DynamicResource MainBtnColor}"/>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#444444" CornerRadius="3" Margin="0,2,0,2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Фирменный стиль карточки выбора для оверлеев -->
        <Style x:Key="CyberSelectListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardBorder" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ActionIcon" Grid.Column="1" Text="→" Foreground="#3F3F46" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#27272A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#172554"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="ActionIcon" Property="Text" Value="✓"/>
                                <Setter TargetName="ActionIcon" Property="Foreground" Value="#60A5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="MainGrid" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
                    <DoubleAnimation Storyboard.TargetName="MainGridTranslate" Storyboard.TargetProperty="Y" From="15" To="0" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid x:Name="MainGrid" Margin="20,14,20,16" Opacity="0" RenderTransformOrigin="0.5,0.5">

        <Grid.Effect>
            <DropShadowEffect x:Name="MainGridGlitchShadow" Color="#00FFFF" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
        </Grid.Effect>

        <Grid.RenderTransform>
            <TransformGroup>
                <TranslateTransform x:Name="MainGridTranslate" X="0" Y="15"/>
                <SkewTransform x:Name="MainGridSkew" AngleX="0"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <Grid x:Name="ContentGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel x:Name="HeaderStack" Grid.Row="0" HorizontalAlignment="Center" Margin="0,4,0,16">
                <TextBlock x:Name="TxtHeaderTitle" Text="⚡ Починить Telegram и Discord" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtHeaderSub" Text="Одна кнопка — запустит всё необходимое." Foreground="#A0A0A0" FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="285"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ToggleButton x:Name="MainToggle" Width="190" Height="190" Click="MainToggle_Click" Cursor="Hand" Background="Transparent" BorderThickness="0">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="BtnBorder" Background="#121212" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="3" CornerRadius="100" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>

                                    <Border.Effect>
                                        <DropShadowEffect Color="{DynamicResource MainBtnColor}" BlurRadius="20" ShadowDepth="0" Opacity="0"/>
                                    </Border.Effect>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="46" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="BtnText" Text="Починить интернет" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <ControlTemplate.Triggers>
                                    <EventTrigger RoutedEvent="PreviewMouseDown">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="BtnBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.95" Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetName="BtnBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.95" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="PreviewMouseUp">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="BtnBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase Amplitude="0.5" EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="BtnBorder" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase Amplitude="0.5" EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>

                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource MainBtnBrush}"/>
                                        <Setter TargetName="BtnText" Property="Text" Value="Остановить"/>
                                        <Trigger.EnterActions>
                                            <BeginStoryboard Name="PulseStoryboard">
                                                <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="BtnBorder" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" From="0.3" To="0.9" Duration="0:0:1.5" />
                                                    <DoubleAnimation Storyboard.TargetName="BtnBorder" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)" From="30" To="70" Duration="0:0:1.5" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="PulseStoryboard" />
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="BtnBorder" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0" Duration="0:0:0.3" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </StackPanel>

                <StackPanel x:Name="NetworkStatsPanel" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,40,0">
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#A0A0A0" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Входящий" Foreground="#A0A0A0" FontSize="12" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="DownloadText" Text="0.0" Foreground="#FFFFFF" FontSize="24" FontWeight="Bold" FontFamily="Consolas"/>
                                <TextBlock Text=" Мбит/с" Foreground="#888888" FontSize="12" VerticalAlignment="Bottom" Margin="4,0,0,6"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#A0A0A0" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Исходящий" Foreground="#A0A0A0" FontSize="12" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="UploadText" Text="0.0" Foreground="#FFFFFF" FontSize="24" FontWeight="Bold" FontFamily="Consolas"/>
                                <TextBlock Text=" Мбит/с" Foreground="#888888" FontSize="12" VerticalAlignment="Bottom" Margin="4,0,0,6"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#A0A0A0" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Пинг (EU Frankfurt)" Foreground="#A0A0A0" FontSize="12" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="PingText" Text="..." Foreground="#FFFFFF" FontSize="24" FontWeight="Bold" FontFamily="Consolas"/>
                                <TextBlock Text=" мс" Foreground="#888888" FontSize="12" VerticalAlignment="Bottom" Margin="4,0,0,6"/>
                            </StackPanel>
                        </StackPanel>

                        <ui:Button Grid.Column="2" x:Name="BtnRefreshPing" Appearance="Transparent" Foreground="#A0A0A0" Cursor="Hand" VerticalAlignment="Bottom" Margin="15,0,0,0" Padding="5,5,5,8" Click="BtnRefreshPing_Click">
                            <TextBlock x:Name="PingIcon" Text="&#xE149;" FontFamily="Segoe MDL2 Assets" FontSize="14" FontWeight="Bold" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="PingIconTransform" Angle="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </ui:Button>
                    </Grid>
                </StackPanel>

                <!-- ПРАВАЯ КОЛОНКА С КАРТОЧКАМИ -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Border x:Name="ZapretCardBorder" Background="#181818" CornerRadius="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,0,10">
                        <StackPanel x:Name="ZapretCardPanel" Margin="16,14">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Настройки Zapret" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ZapretToggle" Style="{StaticResource CyberToggleStyle}" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Settings_Changed"/>
                            </Grid>
                            <TextBlock x:Name="StatusText" Text="Остановлен" FontSize="12" Foreground="#D13438" Margin="0,0,0,10"/>

                            <!-- Кнопка выбора конфига -->
                            <Border x:Name="BtnOpenConfigMenu" Background="#222222" CornerRadius="8" Padding="12,8" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonDown="BtnOpenConfigMenu_MouseDown">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2A2A2A"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Текущий конфиг:" Foreground="#888888" FontSize="11" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="TxtMainProfile" FontFamily="Consolas" Text="general.bat" Foreground="White" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="#888888" FontSize="15" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- Кнопка открытия меню Game Filter -->
                            <Border x:Name="BtnOpenGameFilterMenu" Background="#222222" CornerRadius="8" Padding="12,8" Cursor="Hand" MouseLeftButtonDown="BtnOpenGameFilterMenu_MouseDown">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2A2A2A"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Игровой фильтр (Game Filter):" Foreground="#888888" FontSize="11" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="TxtGameFilterStatus" FontFamily="Consolas" Text="Отключен" Foreground="#A0A0A0" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" Foreground="#60A5FA" FontSize="15" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ProxyCardBorder" Background="#181818" CornerRadius="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <StackPanel x:Name="ProxyCardPanel" Margin="16,12">
                            <Grid Margin="0,0,0,3">
                                <TextBlock Text="TgWsProxy" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <CheckBox x:Name="TgProxyToggle" Style="{StaticResource CyberToggleStyle}" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Settings_Changed"/>
                            </Grid>
                            <TextBlock Text="Прокси для Telegram" Foreground="#A0A0A0" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <ProgressBar x:Name="LaunchProgressBar" Grid.Row="2" Height="4" VerticalAlignment="Top" Margin="0,5,0,0" Foreground="{DynamicResource BrandSuccessBrush}" Background="#181818" BorderThickness="0" Value="0" Visibility="Collapsed">
                <ProgressBar.Effect>
                    <DropShadowEffect Color="{DynamicResource MainBtnColor}" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                </ProgressBar.Effect>
            </ProgressBar>

            <Border x:Name="LogsPanel" Height="235" Grid.Row="2" Background="#0A0A0A" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,14,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="15,12,15,5">
                        <TextBlock Text="Лог событий" Foreground="#A0A0A0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnClearLogs_Click" Margin="0,0,10,0" Padding="5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="#A0A0A0" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Очистить" Foreground="#A0A0A0" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnExportLogs_Click" Padding="5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE78C;" FontFamily="Segoe MDL2 Assets" Foreground="#A0A0A0" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Экспорт" Foreground="#A0A0A0" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <RichTextBox x:Name="LogRichTextBox" Grid.Row="1" Margin="15,0,15,10" Background="Transparent" BorderThickness="0" IsReadOnly="True" VerticalScrollBarVisibility="Auto">
                        <FlowDocument x:Name="LogDocument" PagePadding="0" FontFamily="Consolas" FontSize="13"/>
                    </RichTextBox>
                </Grid>
            </Border>
        </Grid>

        <!-- ОВЕРЛЕЙ ЦЕНТРАЛЬНОГО МЕНЮ ВЫБОРА КОНФИГОВ (Полноценная ширина 550) -->
        <Grid x:Name="ConfigOverlay" Background="#CC000000" Visibility="Collapsed" Panel.ZIndex="100" MouseDown="OverlayBackground_MouseDown">

            <Border x:Name="OverlayContentBorder" Background="#141414" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="12" 
            HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20" Width="550"
            MouseDown="OverlayContent_MouseDown" RenderTransformOrigin="0.5,0.5">

                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                        <TranslateTransform Y="10"/>
                    </TransformGroup>
                </Border.RenderTransform>

                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="10" Opacity="0.8"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="32" Height="32" Background="#1E3A8A" CornerRadius="8" Margin="0,0,12,0">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="#60A5FA" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Zapret" Foreground="#888888" FontSize="12" Margin="0,0,0,2"/>
                            <TextBlock Text="Настройка конфига" Foreground="White" FontSize="16" FontWeight="Bold"/>
                        </StackPanel>

                        <Button Grid.Column="2" Content="✕" Background="Transparent" Foreground="#888888" BorderThickness="0" FontSize="16" Cursor="Hand" Click="BtnCloseOverlay_Click" VerticalAlignment="Top"/>
                    </Grid>

                    <WrapPanel Grid.Row="1" Margin="0,0,0,20">
                        <TextBlock Text="Активный конфиг: " Foreground="White" FontSize="15" FontWeight="Bold"/>
                        <TextBlock x:Name="OverlayTxtProfile" FontFamily="Consolas" Text="general.bat" Foreground="{DynamicResource BrandSuccessBrush}" FontSize="15" FontWeight="Bold"/>
                    </WrapPanel>

                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <TextBlock Text="Доступные конфиги" Foreground="#AAAAAA" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border HorizontalAlignment="Right" Background="#1E293B" CornerRadius="6" Padding="8,4">
                            <TextBlock x:Name="TxtConfigsCount" FontFamily="Consolas" Text="0 конфигов" Foreground="#60A5FA" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <ListBox x:Name="OverlayProfileListBox" Grid.Row="3" Background="Transparent" BorderThickness="0" 
         SelectionChanged="OverlayProfileListBox_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False" MaxHeight="290" Margin="0,0,0,15" Padding="0,0,8,0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,8,8"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="CardBorder" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="10" Padding="15,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                            <TextBlock Text="{Binding FileName}" FontFamily="Consolas" Foreground="{DynamicResource BrandSuccessBrush}" FontSize="15" FontWeight="SemiBold"/>
                                                            <Border x:Name="ActiveBadge" Background="#1E3A8A" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" Visibility="Collapsed">
                                                                <TextBlock Text="активный" Foreground="#60A5FA" FontSize="11" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding MetaInfo}" Foreground="#71717A" FontSize="13"/>
                                                    </StackPanel>

                                                    <TextBlock x:Name="ActionIcon" Grid.Column="1" Text="→" Foreground="#3F3F46" FontSize="16" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                </Grid>
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CardBorder" Property="Background" Value="#27272A"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter TargetName="CardBorder" Property="Background" Value="#172554"/>
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="#2563EB"/>
                                                    <Setter TargetName="ActiveBadge" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="ActionIcon" Property="Text" Value="✓"/>
                                                    <Setter TargetName="ActionIcon" Property="Foreground" Value="#60A5FA"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <Button x:Name="BtnStartScan" Grid.Row="4" HorizontalAlignment="Stretch" Padding="0,14" Cursor="Hand" Click="BtnStartScan_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="#27272A" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#3F3F46"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="ScanIcon" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ScanText" Text="Запустить авто-подбор (Smart DPI Scan)" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ОВЕРЛЕЙ НАСТРОЙКИ GAME FILTER (С фирменным списком карточек вместо стандартного ComboBox) -->
        <Grid x:Name="GameFilterOverlay" Background="#CC000000" Visibility="Collapsed" Panel.ZIndex="110" MouseDown="GameFilterOverlay_MouseDown">
            <Border x:Name="GameFilterContentBorder" Background="#141414" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20" Width="490"
                    MouseDown="OverlayContent_MouseDown" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                        <TranslateTransform Y="10"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="10" Opacity="0.8"/>
                </Border.Effect>

                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="34" Height="34" Background="#1E3A8A" CornerRadius="8" Margin="0,0,12,0">
                            <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" Foreground="#60A5FA" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Маршрутизация игровых портов" Foreground="#888888" FontSize="12"/>
                            <TextBlock Text="Настройка Game Filter" Foreground="White" FontSize="16" FontWeight="Bold"/>
                        </StackPanel>

                        <Button Grid.Column="2" Content="✕" Background="Transparent" Foreground="#888888" BorderThickness="0" FontSize="16" Cursor="Hand" Click="BtnCloseGameFilter_Click" VerticalAlignment="Top"/>
                    </Grid>

                    <TextBlock Text="Режим перехвата трафика игр:" Foreground="#CCCCCC" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <!-- Наш фирменный список карточек вместо системного ComboBox -->
                    <ListBox x:Name="ListGameFilterMode" Background="Transparent" BorderThickness="0" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource CyberSelectListBoxItem}" Margin="0,0,0,10" SelectionChanged="ComboGameFilterMode_SelectionChanged">
                        <ListBoxItem>
                            <StackPanel>
                                <TextBlock Text="Отключен" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="По умолчанию — фильтрация игровых портов выключена (порт 12)" Foreground="#71717A" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel>
                                <TextBlock Text="TCP и UDP (Рекомендуется)" Foreground="{DynamicResource BrandSuccessBrush}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Полный обход для большинства онлайн-игр и игровых лаунчеров" Foreground="#71717A" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel>
                                <TextBlock Text="Только TCP" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Перехват только TCP-соединений игровых серверов" Foreground="#71717A" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel>
                                <TextBlock Text="Только UDP" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Перехват только UDP-трафика (голосовые чаты и динамичные шутеры)" Foreground="#71717A" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Диапазон TCP портов:" Foreground="#A0A0A0" FontSize="12" Margin="0,0,0,4"/>
                            <ui:TextBox x:Name="TxtGameFilterTcp" FontFamily="Consolas" Text="1024-65535" PlaceholderText="1024-65535"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Диапазон UDP портов:" Foreground="#A0A0A0" FontSize="12" Margin="0,0,0,4"/>
                            <ui:TextBox x:Name="TxtGameFilterUdp" FontFamily="Consolas" Text="1024-65535" PlaceholderText="1024-65535"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Button Content="Сбросить (1024-65535)" Background="Transparent" Foreground="#888888" BorderBrush="#333333" BorderThickness="1" Padding="12,6" HorizontalAlignment="Left" Cursor="Hand" Click="BtnResetGameFilterPorts_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Отмена" Background="Transparent" Foreground="#A0A0A0" BorderBrush="#333333" BorderThickness="1" Padding="14,6" Margin="0,0,10,0" Cursor="Hand" Click="BtnCloseGameFilter_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="💾 Применить" Background="{DynamicResource BrandSuccessBrush}" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Padding="16,6" Cursor="Hand" Click="BtnSaveGameFilter_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>