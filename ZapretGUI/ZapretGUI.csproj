<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Настройки сборки в ОДИН чистый .exe -->
		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>false</SelfContained>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<PublishTrimmed>false</PublishTrimmed>

		<!-- Отключаем генерацию лишних файлов (.pdb, .xml) в релизе -->
		<DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
		<DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>

		<!-- Упаковываем нативный WebView2Loader.dll внутрь сборки -->
		<WebView2LoaderPreference>Static</WebView2LoaderPreference>
	</PropertyGroup>

	<!-- WebView2 зависимость -->
	<ItemGroup>
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
	</ItemGroup>

	<!-- Звуки встраиваем как Embedded Resource напрямую внутрь .exe -->
	<ItemGroup>
		<Resource Include="Assets\Sounds\click.wav" Condition="Exists('Assets\Sounds\click.wav')" />
		<Resource Include="Assets\Sounds\success.wav" Condition="Exists('Assets\Sounds\success.wav')" />
	</ItemGroup>

	<!-- АВТОМАТИЧЕСКАЯ АРХИВАЦИЯ ИНТЕРФЕЙСА ПЕРЕД СБОРКОЙ -->
	<Target Name="ZipWebUI" BeforeTargets="BeforeBuild">
		<ZipDirectory SourceDirectory="$(MSBuildProjectDirectory)\wwwroot" DestinationFile="$(IntermediateOutputPath)wwwroot.zip" Overwrite="true" />
		<ItemGroup>
			<EmbeddedResource Include="$(IntermediateOutputPath)wwwroot.zip" LogicalName="wwwroot.zip" />
		</ItemGroup>
	</Target>

	<!-- Копируем в Publish директорию ТОЛЬКО ядро (ZapretFiles) и README -->
	<ItemGroup>
		<None Include="ZapretFiles\**\*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Include="README.md" Condition="Exists('README.md')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

</Project>